boneBtn.Font = Enum.Font.GothamBold
boneBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", boneBtn)
boneBtn.MouseButton1Click:Connect(function()
	aimbotPart = (aimbotPart=="Head" and "UpperTorso" or "Head")
	boneBtn.Text = "TARGET BONE: "..aimbotPart:upper()
end)

createSlider("Aimbot FOV", 10, 800, 100, function(v) aimbotFOV = v end)
createSlider("Aim Smoothness", 1, 100, 20, function(v) aimbotSmoothness = v end)
createToggle("Anti-Recoil (ADS+Fire)", false, function(v) antiRecoilOn = v end)
createSlider("Recoil Strength", 0, 2, 0.35, function(v) recoilStrength = v end)

--// ================= GUI: BLACKLIST =================
local blGui = Instance.new("ScreenGui")
blGui.Name = "Blacklist_UI"
blGui.ResetOnSpawn = false
blGui.Enabled = false
blGui.Parent = player:WaitForChild("PlayerGui")

local blFrame = Instance.new("Frame", blGui)
blFrame.AnchorPoint = Vector2.new(0.5,0.5)
blFrame.Position = UDim2.fromScale(0.5,0.5)
blFrame.Size = UDim2.fromScale(0.36,0.6)
blFrame.BackgroundColor3 = Color3.fromRGB(20,20,30)
blFrame.Active = true
blFrame.Draggable = true
blFrame.BorderSizePixel = 0
Instance.new("UICorner", blFrame).CornerRadius = UDim.new(0,12)

local blTitle = Instance.new("TextLabel", blFrame)
blTitle.Size = UDim2.fromScale(1,0.1)
blTitle.BackgroundTransparency = 1
blTitle.Text = "Blacklist Manager"
blTitle.Font = Enum.Font.GothamBold
blTitle.TextSize = 26
blTitle.TextColor3 = Color3.fromRGB(170,0,255)

local list = Instance.new("ScrollingFrame", blFrame)
list.Position = UDim2.fromScale(0.03,0.12)
list.Size = UDim2.fromScale(0.94,0.85)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 6

local blLayout = Instance.new("UIListLayout", list)
blLayout.Padding = UDim.new(0,6)

local function addRow(plr)
	if plr == player then return end
	if list:FindFirstChild(plr.Name) then return end

	local row = Instance.new("Frame", list)
	row.Name = plr.Name
	row.Size = UDim2.new(1,0,0,44)
	row.BackgroundColor3 = Color3.fromRGB(35,35,45)
	row.BorderSizePixel = 0
	Instance.new("UICorner", row).CornerRadius = UDim.new(0,6)

	local nameL = Instance.new("TextLabel", row)
	nameL.Size = UDim2.fromScale(0.65,1)
	nameL.Position = UDim2.fromScale(0.03,0)
	nameL.BackgroundTransparency = 1
	nameL.Text = plr.Name
	nameL.Font = Enum.Font.GothamBold
	nameL.TextSize = 20
	nameL.TextXAlignment = Enum.TextXAlignment.Left
	nameL.TextColor3 = Color3.new(1,1,1)

	local btn = Instance.new("TextButton", row)
	btn.Size = UDim2.fromScale(0.25,0.65)
	btn.Position = UDim2.fromScale(0.72,0.18)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 18
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BorderSizePixel = 0
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

	local function upd()
		local i = table.find(Settings.Blacklist, plr.Name)
		btn.Text = i and "Ignored" or "Add"
		btn.BackgroundColor3 = i and Color3.fromRGB(120,120,120) or Color3.fromRGB(0,200,100)
	end

	btn.MouseButton1Click:Connect(function()
		local i = table.find(Settings.Blacklist, plr.Name)
		if i then table.remove(Settings.Blacklist, i) else table.insert(Settings.Blacklist, plr.Name) end
		upd()
	end)
	upd()
end

local function refreshBlacklist()
	for _,c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	for _,p in ipairs(Players:GetPlayers()) do addRow(p) end
	task.wait()
	list.CanvasSize = UDim2.new(0,0,0, blLayout.AbsoluteContentSize.Y+10)
end

Players.PlayerAdded:Connect(function() if BLMenuOpen then refreshBlacklist() end end)
Players.PlayerRemoving:Connect(function() if BLMenuOpen then refreshBlacklist() end end)

--// ================= INPUT (INSERT / DELETE FIX) =================
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.LeftAlt then aimbotOn = not aimbotOn end
	if input.KeyCode == Enum.KeyCode.V then antiRecoilOn = not antiRecoilOn end
	if input.KeyCode == Enum.KeyCode.F then fovVisible = not fovVisible end

	if input.KeyCode == Enum.KeyCode.Insert then
		MainMenuOpen = not MainMenuOpen
		BLMenuOpen = false
		gui.Enabled = MainMenuOpen
		blGui.Enabled = false
	end

	if input.KeyCode == Enum.KeyCode.Delete then
		BLMenuOpen = not BLMenuOpen
		MainMenuOpen = false
		blGui.Enabled = BLMenuOpen
		gui.Enabled = false
		if BLMenuOpen then refreshBlacklist() end
	end

	updateMouse()
end)

UIS.MouseIconEnabled = true
updateMouse()
