--// SERVICES
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local mouse = player:GetMouse()

--// GLOBAL SETTINGS
_G.Settings = _G.Settings or {}
_G.Settings.Blacklist = _G.Settings.Blacklist or {}
local Settings = _G.Settings

--// AIM SETTINGS
local aimbotOn = false
local teamCheckOn = false
local antiRecoilOn = false
local recoilStrength = 0.35
local aimbotFOV = 100
local aimbotSmoothness = 20
local aimbotPart = "Head"

--// STATES
local MainMenuOpen = false
local BLMenuOpen = false
local fovVisible = true

--// ================= MOUSE CONTROL (FIX) =================
local function updateMouse()
	if MainMenuOpen or BLMenuOpen then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		UIS.MouseIconEnabled = true
	end
end

--// VISIBILITY CHECK
local function isTargetVisible(targetPart)
	if not targetPart then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = { player.Character }
	local res = workspace:Raycast(
		Camera.CFrame.Position,
		targetPart.Position - Camera.CFrame.Position,
		params
	)
	return res and res.Instance:IsDescendantOf(targetPart.Parent)
end

--// GET CLOSEST
local function getClosest()
	local closest = nil
	local closestScreenDist = aimbotFOV
	local closestWorldDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			if teamCheckOn and plr.Team == player.Team then continue end
			if table.find(Settings.Blacklist, plr.Name) then continue end

			local part = plr.Character:FindFirstChild(aimbotPart)
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")

			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
if part and hrp and hum and hum.Health > 0 then
				local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen then
					-- FOV kontrolü (mouse mesafesi)
					local screenDist =
						(Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude

					if screenDist <= aimbotFOV and isTargetVisible(part) then
						-- Dünya mesafesi (gerçek yakınlık)
						local worldDist =
							(Camera.CFrame.Position - hrp.Position).Magnitude

						-- Önce dünya mesafesi, eşitse mouse mesafesi
						if worldDist < closestWorldDist
							or (worldDist == closestWorldDist and screenDist < closestScreenDist) then

							closestWorldDist = worldDist
							closestScreenDist = screenDist
							closest = part
						end
					end
				end
			end
		end
	end

	return closest
end

--// FOV DRAW
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.Transparency = 0.6
fovCircle.Filled = false

--// ================= RENDER =================
RunService.RenderStepped:Connect(function()
	-- 🔒 OYUN İÇİNDE MOUSE ASLA KAÇMAZ
	if aimbotOn and not MainMenuOpen and not BLMenuOpen then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
		UIS.MouseIconEnabled = false
	end

	fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	fovCircle.Radius = aimbotFOV
	fovCircle.Visible = fovVisible
	fovCircle.Color = aimbotOn and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,255,255)

	-- AIM (RIGHT CLICK)
	if aimbotOn and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local t = getClosest()
		if t then
			Camera.CFrame = Camera.CFrame:Lerp(
				CFrame.new(Camera.CFrame.Position, t.Position),
				1 / aimbotSmoothness
			)
		end
	end

	-- NO RECOIL
	if antiRecoilOn
		and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		Camera.CFrame = Camera.CFrame * CFrame.Angles(math.rad(-recoilStrength), 0, 0)
	end
end)

