local container = Instance.new("ScrollingFrame", main)
container.Position = UDim2.new(0,15,0,50)
container.Size = UDim2.new(1,-30,1,-65)
container.BackgroundTransparency = 1
container.ScrollBarThickness = 0
container.CanvasSize = UDim2.new(0,0,1.4,0)

local layout = Instance.new("UIListLayout", container)
layout.Padding = UDim.new(0,12)

local function createToggle(name, default, cb)
	local b = Instance.new("TextButton", container)
	b.Size = UDim2.new(1,0,0,38)
	b.BackgroundTransparency = 0.4
	b.BackgroundColor3 = default and Color3.fromRGB(0,180,100) or Color3.fromRGB(30,30,40)
	b.Text = name..": "..(default and "ON" or "OFF")
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextColor3 = Color3.new(1,1,1)
	Instance.new("UICorner", b)
	b.MouseButton1Click:Connect(function()
		default = not default
		b.Text = name..": "..(default and "ON" or "OFF")
		b.BackgroundColor3 = default and Color3.fromRGB(0,180,100) or Color3.fromRGB(30,30,40)
		cb(default)
	end)
end

local function createSlider(name, min, max, default, cb)
	local holder = Instance.new("Frame", container)
	holder.Size = UDim2.new(1,0,0,45)
	holder.BackgroundTransparency = 1

	local label = Instance.new("TextLabel", holder)
	label.Size = UDim2.new(1,0,0,20)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextSize = 12
	label.TextColor3 = Color3.fromRGB(200,200,200)
	label.Text = name..": "..string.format("%.2f", default)

	local bg = Instance.new("Frame", holder)
	bg.Size = UDim2.new(1,0,0,5)
	bg.Position = UDim2.new(0,0,0,25)
	bg.BackgroundColor3 = Color3.fromRGB(50,50,60)
	Instance.new("UICorner", bg)

	local fill = Instance.new("Frame", bg)
	fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
	fill.BackgroundColor3 = Color3.fromRGB(0,255,255)
	Instance.new("UICorner", fill)

	local function update(input)
		local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X)/bg.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(pos,0,1,0)
		local v = min + pos*(max-min)
		label.Text = name..": "..string.format("%.2f", v)
		cb(v)
	end

	bg.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			local c; c = UIS.InputChanged:Connect(function(m)
				if m.UserInputType == Enum.UserInputType.MouseMovement then update(m) end
			end)
			UIS.InputEnded:Once(function() c:Disconnect() end)
		end
	end)
end

createToggle("Master Aimbot", false, function(v) aimbotOn = v end)
createToggle("Team Check", false, function(v) teamCheckOn = v end)

